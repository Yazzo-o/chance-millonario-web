rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Initial default-deny baseline. Functions using Admin SDK must enforce roles explicitly.
    match /users/{userId} { allow read, write: if false; }
    match /alerts/{alertId} { allow read, write: if false; }
    match /devices/{deviceId} { allow read, write: if false; }
    match /acknowledgments/{ackId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
